# ---- Telegram (required to run the bot) ----
# Get a token from @BotFather. CHAT_ID: message the bot once, then run
#   curl -s "https://api.telegram.org/bot<TOKEN>/getUpdates"
# and copy the numeric "chat":{"id":...} value.
BOT_TOKEN=your_token_here
CHAT_ID=your_chat_id_here

# ---- Optional: risk / trading defaults ----
ACCOUNT_BALANCE=10000
RISK_PER_TRADE=1.0
DAILY_LOSS_LIMIT=3.0
MAX_CONSECUTIVE_LOSSES=4

# ---- Optional: scanner cadence (seconds between scans) ----
SCAN_INTERVAL_SEC=150

# ---- Auto-trading agent ----
# Paper mode (default): simulated fills, no real orders. Safe to test.
# MT5 mode (Windows): drives your MetaTrader5 terminal — set MT5_LOGIN / PASSWORD /
#   SERVER from your Headway demo account, and keep the MT5 terminal logged in.
#   Install the driver lib once:  pip install MetaTrader5
AUTO_TRADE_ENV=paper
ALLOW_LIVE=

# ---- MT5 / Headway demo credentials (for AUTO_TRADE_ENV=mt5) ----
# From MetaTrader5 terminal: File->Login to Trade Account -> enter demo login/password
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# Optional: absolute path to terminal64.exe (auto-found if blank)
MT5_PATH=
MT5_DEVIATION=20
MT5_MAGIC=7710

# ---- OANDA demo credentials (for AUTO_TRADE_ENV=demo, .env already explains) ----
OANDA_TOKEN=
OANDA_ACCOUNT_ID=

# Poll cadence: seconds between state.json fetches from the public GitHub repo
AGENT_POLL_SEC=20

# State URL: points at the public raw GitHub file (no auth needed)
AGENT_STATE_URL=https://raw.githubusercontent.com/Glitch-WRLD/goldfx-github/main/gha_state/state.json